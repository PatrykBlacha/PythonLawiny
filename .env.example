# Przykładowy plik konfiguracyjny .env
# Skopiuj ten plik do .env i uzupełnij właściwymi wartościami

# Adres URL do bazy danych (domyślnie SQLite w folderze głównym)
# W środowisku produkcyjnym podaj adres do np. PostgreSQL
SQLALCHEMY_DATABASE_URI=sqlite:///users.db

# Tajny klucz aplikacji (wymagany przez m.in. flask_login do bezpiecznych sesji)
# Wygeneruj własny, silny klucz w środowisku produkcyjnym!
SECRET_KEY=zmien_ten_klucz_na_produkcji